    { "id": "iop", "name": "Presión intraocular (IOP)", "unit": "mmHg", "hazard": "gravityFields", "source": "nasa-sans", "status": "heuristic", "validation": { "checked": "2026-11-15", "result": "partial", "datasets": [ { "source": "osdr-osd-816", "accession": "OSD-816", "organism": "Homo sapiens (ex vivo donor eyes)", "finding": "The ground analog of SANS uses IOP 16 mmHg as the control condition and 21 mmHg as the elevated condition (ICP:IOP 12:16, 15:16, 12:21, 21:16 mmHg)." }, { "source": "osdr-osd-715", "accession": "OSD-715", "organism": "Mus musculus (ISS, 35 days)", "finding": "Measured IOP stayed between 14.4 and 20.3 mmHg before and after flight (post-flight 14.4-19.3 vs pre-flight 16.3-20.3 mmHg)." }, { "source": "lsda-rr9", "accession": "RR-9", "organism": "Mus musculus (ISS, 35 days)", "finding": "LSDA record of the RR-9 flight experiment behind OSD-715." } ], "supports": "The normal/watch boundary at 21 mmHg.", "doesNotSupport": "The critical edge (25 mmHg) and the lower edge (10 mmHg): the datasets do not measure them. Mouse and ex vivo data are not human in-flight IOP." }, "bands": [ { "status": "normal", "min": 10, "max": 21 }, { "status": "watch", "min": 21, "max": 25 }, { "status": "critical", "min": 25 } ] },
