    { "id": "gravity", "name": "Gravedad", "unit": "g", "hazard": "gravityFields", "source": "nasa-hrp", "status": "heuristic", "validation": { "checked": "2026-11-15", "result": "needsReview", "datasets": [ { "source": "osdr-osd-714", "accession": "OSD-714", "organism": "Mus musculus (ISS centrifuge, 1/6 g)", "finding": "Lunar gravity (1/6 g) prevented microgravity-induced soleus muscle atrophy, but did not prevent the slow-to-fast myofiber shift." } ], "supports": "That microgravity (0 g) is a real risk factor for muscle.", "doesNotSupport": "Marking every value below 0.3 g as critical: in this dataset 1/6 g (about 0.17 g) protected muscle mass. Consider watch instead of critical for lunar gravity. Single mouse study, so the bands are left unchanged until the team reviews them." }, "bands": [ { "status": "normal", "min": 0.9, "max": 1.1 }, { "status": "watch", "min": 0.3, "max": 0.9 }, { "status": "critical", "max": 0.3 } ] },
